# --- Telegram Bot (from @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_from_botfather

# Pick any random string yourself — used to verify webhook calls really came
# from Telegram. Set the same value when you register the webhook (see README).
TELEGRAM_WEBHOOK_SECRET=pick_any_random_string_here

# --- Gemini (primary) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Groq (fallback if Gemini fails/rate-limits) ---
# Free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# --- Your Django site (3dproductgallery.in) ---
DJANGO_API_BASE_URL=https://3dproductgallery.in
DJANGO_PUBLISH_SECRET=pick_a_long_random_string_matching_django_env

# Rough INR cost per gram of PLA print -- used to compute price whenever an
# STL was provided (overrides Gemini's guess). Adjust to match your real
# material + printer running costs.
PRICE_PER_GRAM_INR=8

# --- Access control: only these Telegram user IDs can use the bot ---
# Leave blank at first — the bot will tell you your own ID when you message
# it, then come back and set this and redeploy.
ALLOWED_SENDERS=
